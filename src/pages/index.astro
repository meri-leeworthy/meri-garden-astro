---
import Main from "../layouts/Main.astro"
import { getCollection } from "astro:content"
import ProjectCard from "../components/ProjectCard.astro"
import { readCache } from "../../lib/pds"

const items = await getCollection("work")
const sortedItems = items
    .filter((p) => !!p.data.portfolio)
    .sort(
        (a, b) =>
            (b.data.date ? new Date(b.data.date).valueOf() : 1) -
            (a.data.date ? new Date(a.data.date).valueOf() : 1)
    )

const pdsDocs = readCache()
const recentPosts = pdsDocs
    .filter((d) => d.content || d.textContent)
    .sort(
        (a, b) =>
            new Date(b.publishedAt).valueOf() - new Date(a.publishedAt).valueOf()
    )
    .slice(0, 5)

function stripMarkdown(md: string): string {
    return (
        md
            // Remove headers
            .replace(/^#{1,6}\s+/gm, "")
            // Remove bold/italic
            .replace(/\*\*\*/g, "")
            .replace(/\*\*/g, "")
            .replace(/\*/g, "")
            .replace(/___/g, "")
            .replace(/__/g, "")
            .replace(/_/g, "")
            // Remove strikethrough
            .replace(/~~/g, "")
            // Remove inline code
            .replace(/`/g, "")
            // Remove links but keep text
            .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
            // Remove images
            .replace(/!\[([^\]]*)\]\([^)]+\)/g, "$1")
            // Clean up extra whitespace
            .replace(/\s+/g, " ")
            .trim()
    )
}

function getSnippet(item: any) {
    const rawText =
        item.body?.split("\n\n")[0]?.trim() ||
        item.data.description ||
        "Project writeup coming soon."
    const text = stripMarkdown(rawText)
    return text.length > 150 ? text.slice(0, 147) + "..." : text
}
---

<Main
    title="Meri Leeworthy"
    description="I'm a programmer, designer, writer and artist. I try to make tools for community autonomy, creativity, and resistance."
    image="https://static.meri.garden/mesh-gradient.png"
>
    <div class="flex flex-col w-screen px-4 pt-16 isolate">
        <section class="flex flex-col w-full max-w-sm gap-4 pl-20 mx-auto">
            <aside class="text-xl">
                I'm a programmer, designer, writer and artist.<br /><br />
                I make tools for community autonomy, creativity, and resistance.
            </aside>
        </section>

        <section class="w-full max-w-3xl mx-auto mt-32 flex flex-col">
            <div class="flex justify-between">
                <h2 class="text-2xl font-title mb-2">Projects</h2>
                <p
                    class="text-black/70 text-sm text-right w-60 max-w-1/2 self-end mb-8"
                >
                    Contact me at <a
                        href="mailto:hello@meri.garden"
                        class="text-black">hello@meri.garden</a
                    > to discuss design and technical consulting projects.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {
                    sortedItems.map((item) => (
                        <ProjectCard
                            title={item.data.title}
                            slug={item.data.slug}
                            image={item.data.image}
                            alt={item.data.alt}
                            tags={item.data.tags}
                            snippet={getSnippet(item)}
                        />
                    ))
                }
            </div>
        </section>
        <section class="w-full max-w-lg mx-auto mt-32">
            <h2 class="text-2xl font-title mb-8">Writing</h2>
            <ul class="flex flex-col gap-3 mt-6 font-title list-['↠']">
                {
                    recentPosts.map((post) => (
                        <li class="link-list">
                            <a href={`/posts/${post.slug.replace("posts/", "")}`}>
                                {post.title}
                            </a>
                        </li>
                    ))
                }
            </ul>
            <div class="w-full my-4">
                <a href="/posts" class="font-title underline text-sm"
                    >See more</a
                >
            </div>
        </section>
    </div>
</Main>
