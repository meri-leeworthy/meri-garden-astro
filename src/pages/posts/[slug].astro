---
import Main from "../../layouts/Main.astro"
import { readCache } from "../../../lib/pds"
import { renderDocumentContent, collectBskyPostUris } from "../../../lib/render-leaflet"
import { loadBskyPostEmbeds } from "../../../lib/bsky-embed"
import fs from "fs"
import path from "path"

interface Backlink {
    slug: string
    title: string
    path: string
}

export async function getStaticPaths() {
    const docs = readCache()
    const backlinksPath = path.join(process.cwd(), "public", "backlinks.json")
    const backlinksData = JSON.parse(fs.readFileSync(backlinksPath, "utf-8"))

    return await Promise.all(
        docs
            .filter((d) => d.content || d.textContent)
            .map(async (doc) => {
                const bskyEmbeds = await loadBskyPostEmbeds(collectBskyPostUris(doc))
                return {
                    params: { slug: doc.slug.replace("posts/", "") },
                    props: {
                        doc,
                        backlinks: (backlinksData[doc.slug] || []) as Backlink[],
                        bskyEmbeds
                    }
                }
            })
    )
}

function formatDate(date: string | Date | undefined) {
    if (!date) return ""
    const d = typeof date === "string" ? new Date(date) : date
    return d.toLocaleDateString("en-AU", {
        year: "numeric",
        month: "long",
        day: "numeric"
    })
}
function coverImageUrl(coverImage: unknown): string {
    if (!coverImage || typeof coverImage !== "object") return ""
    const ref = "ref" in coverImage ? coverImage.ref : undefined
    if (!ref || typeof ref !== "object") return ""
    const cid = "$link" in ref ? ref.$link : undefined
    if (typeof cid !== "string") return ""
    const PDS = "https://shimeji.us-east.host.bsky.network"
    const DID = "did:plc:mmyj7mk7kh3jqhw6zs4prbuk"
    return `${PDS}/xrpc/com.atproto.sync.getBlob?did=${encodeURIComponent(DID)}&cid=${encodeURIComponent(cid)}`
}

const { doc, backlinks, bskyEmbeds } = Astro.props
const html = renderDocumentContent(doc, bskyEmbeds)
const ogImage = coverImageUrl(doc.coverImage)
---

<Main
    title={doc.title}
    description={doc.description || ""}
    image={ogImage}
    atUri={doc.uri}
>
    <article
        class={`prose flex flex-col items-center mx-auto max-w-4xl w-full post pt-16`}
    >
        <div
            class={`relative w-full lg:w-[48rem] mb-12 h-10`}
        >
            <div class="absolute bottom-0 w-4/5 left-1">
                <h1
                    class="inline px-2 py-2 text-lg leading-8 bg-purple-300 rounded-lg shadow-xl lg:text-2xl font-title box-decoration-clone"
                >
                    {doc.title}
                </h1>
            </div>
        </div>
        {
            doc.publishedAt && (
                <div class="font-title px-8 text-right w-full lg:w-[48rem] text-sm text-neutral-600 pb-8">
                    {formatDate(doc.publishedAt)}
                </div>
            )
        }

        <main class="w-full max-w-prose">
            <div set:html={html} />
            {
                backlinks.length > 0 && (
                    <section class="backlinks">
                        <h2>Backlinks</h2>
                        <ul>
                            {backlinks.map((backlink) => (
                                <li>
                                    <a href={backlink.path}>{backlink.title}</a>
                                </li>
                            ))}
                        </ul>
                    </section>
                )
            }
        </main>
    </article>
</Main>
