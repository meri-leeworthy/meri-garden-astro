---
import Main from "../../layouts/Main.astro";
import { readCache } from "../../../lib/pds"

const docs = readCache();
const sortedItems = docs
  .filter((d) => d.content || d.textContent)
  .sort(
    (a, b) =>
      new Date(b.publishedAt).valueOf() - new Date(a.publishedAt).valueOf()
  );
---

<Main
    title="Posts - Meri Leeworthy"
    description="Posts by Meri Leeworthy."
    image="https://static.meri.garden/mesh-gradient.png"
>
    <div class="flex flex-col w-screen px-4 pt-16 isolate">
        <section class="w-full max-w-lg mx-auto">
            <h1 class="text-2xl font-title mb-8">Posts</h1>
            <ul class="flex flex-col gap-3 font-title list-['↠']">
                {
                    sortedItems.map((item) => (
                        <li class="link-list">
                            <a href={`/posts/${item.slug.replace("posts/", "")}`}>
                                {item.title}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </section>
    </div>
</Main>
