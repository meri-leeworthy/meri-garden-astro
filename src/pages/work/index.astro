---
import Main from "../../layouts/Main.astro"
import { getCollection } from "astro:content"
import ProjectCard from "../../components/ProjectCard.astro"

const items = await getCollection("work")
const sortedItems = items
    .filter((p) => !!p.data.portfolio)
    .sort(
        (a, b) =>
            (b.data.date ? new Date(b.data.date).valueOf() : 1) -
            (a.data.date ? new Date(a.data.date).valueOf() : 1)
    )

function stripMarkdown(md: string): string {
    return md
        // Remove headers
        .replace(/^#{1,6}\s+/gm, '')
        // Remove bold/italic
        .replace(/\*\*\*/g, '')
        .replace(/\*\*/g, '')
        .replace(/\*/g, '')
        .replace(/___/g, '')
        .replace(/__/g, '')
        .replace(/_/g, '')
        // Remove strikethrough
        .replace(/~~/g, '')
        // Remove inline code
        .replace(/`/g, '')
        // Remove links but keep text
        .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
        // Remove images
        .replace(/!\[([^\]]*)\]\([^)]+\)/g, '$1')
        // Clean up extra whitespace
        .replace(/\s+/g, ' ')
        .trim()
}

function getSnippet(item: any) {
    const rawText =
        item.body?.split("\n\n")[0]?.trim() ||
        item.data.description ||
        "Project writeup coming soon."
    const text = stripMarkdown(rawText)
    return text.length > 150 ? text.slice(0, 147) + "..." : text
}
---

<Main
    title="Projects - Meri Leeworthy"
    description="Project writeups and work by Meri Leeworthy."
    image="https://static.meri.garden/mesh-gradient.png"
>
    <div class="flex flex-col w-screen px-4 pt-16 isolate">
        <section class="w-full max-w-3xl mx-auto">
            <h1 class="text-2xl font-title mb-8">Projects</h1>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {
                    sortedItems.map((item) => (
                        <ProjectCard
                            title={item.data.title}
                            slug={item.data.slug}
                            image={item.data.image}
                            alt={item.data.alt}
                            tags={item.data.tags}
                            snippet={getSnippet(item)}
                        />
                    ))
                }
            </div>
        </section>
    </div>
</Main>
